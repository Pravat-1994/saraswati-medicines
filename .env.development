# Development environment variables
# DO NOT END ANY OF THESE VALUES WITH A TRAILING SLASH.....
# Vite-exposed portal base (must be prefixed with VITE_ to be available to client code)
VITE_DEC_PORTAL_BASE=/Primary
VITE_DEC_PROJECT_API_BASE_URL=/
# true = use local mock data provider; false = call Decisions flows (see docs/DECISIONS_INTEGRATION.md)
VITE_DEMO_MODE=true
# true = obtain a Decisions JWT before rendering (required when hosted in Decisions with real data)
VITE_REQUIRE_DECISIONS_AUTH=true
VITE_API_TIMEOUT_MS=20000
VITE_MOCK_LATENCY_MS=120
