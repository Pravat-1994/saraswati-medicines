{
  "name": "saraswati-medicines-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo --config vite.config.localdev.ts",
    "localdev": "node scripts/print-dev-jwt-help.mjs && vite --mode localdevelopment --config vite.config.localdev.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build:dev": "tsc -b && vite build --mode development --config vite.config.dev.ts && node scripts/package.mjs dist devDeploy.zip",
    "build:prod": "tsc -b && vite build --mode production --config vite.config.prod.ts && node scripts/package.mjs dist deployPackage.zip",
    "build:pages": "tsc -b && vite build --mode pages --config vite.config.pages.ts",
    "preview:pages": "vite preview --mode pages --config vite.config.pages.ts",
    "build:standalone": "tsc -b && vite build --mode pages --config vite.config.standalone.ts",
    "package:source": "node scripts/package-source.mjs",
    "preview": "vite preview --mode production --config vite.config.prod.ts",
    "test:e2e": "node scripts/e2e.mjs && node scripts/e2e-healthcare.mjs",
    "test:e2e:healthcare": "node scripts/e2e-healthcare.mjs",
    "test:smoke-build": "node scripts/smoke-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "archiver": "^8.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
